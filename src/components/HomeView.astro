---
import CategoryCard from './CategoryCard.astro';
import type { Category } from '../lib/content';
import type { LocalePath } from '../lib/i18n';

interface Props {
  localePath: LocalePath;
  strings: {
    terminology: {
      categories: string;
      equipment: string;
      rent: string;
    };
    market: {
      headline: string;
      subheadline: string;
      cta: string;
    };
  };
  categories: Category[];
}

const { localePath, strings, categories } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-signal">ByronEquipment.com</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight text-ink sm:text-5xl">
        {strings.market.headline}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
        {strings.market.subheadline}
      </p>
      <a href="#categories" class="mt-7 inline-flex rounded bg-safety px-4 py-3 text-sm font-bold text-ink hover:bg-amber-400">
        {strings.market.cta}
      </a>
    </div>
    <div class="rounded border border-slate-200 bg-slate-50 p-5">
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <div class="rounded bg-white p-4">
          <dt class="font-medium text-slate-500">Fleet categories</dt>
          <dd class="mt-2 text-3xl font-bold text-ink">{categories.length}</dd>
        </div>
        <div class="rounded bg-white p-4">
          <dt class="font-medium text-slate-500">RFQ status</dt>
          <dd class="mt-2 text-3xl font-bold text-ink">UI</dd>
        </div>
        <div class="col-span-2 rounded bg-white p-4">
          <dt class="font-medium text-slate-500">Marketplace focus</dt>
          <dd class="mt-2 text-base font-semibold text-ink">Commercial equipment sourcing</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<section id="categories" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-signal">{strings.terminology.equipment}</p>
      <h2 class="mt-2 text-2xl font-bold text-ink">{strings.terminology.categories}</h2>
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    {categories.map((category) => <CategoryCard category={category} localePath={localePath} cta={strings.terminology.rent} />)}
  </div>
</section>
