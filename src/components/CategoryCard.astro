---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Category } from '../lib/content';
import { localeMeta, type LocalePath } from '../lib/i18n';

interface Props {
  category: Category;
  localePath: LocalePath;
  cta: string;
}

const { category, localePath, cta } = Astro.props;
const href = getRelativeLocaleUrl(localeMeta[localePath].code, category.data.localizedSlug);
---

<article class="flex min-h-44 flex-col justify-between rounded border border-slate-200 bg-white p-5 shadow-sm">
  <div>
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-signal">{category.data.locale}</p>
    <h2 class="text-xl font-semibold text-ink">{category.data.title}</h2>
    <p class="mt-3 text-sm leading-6 text-slate-600">{category.data.description}</p>
  </div>
  <a class="mt-5 inline-flex w-fit items-center rounded bg-ink px-3 py-2 text-sm font-semibold text-white hover:bg-signal" href={href}>
    {cta}
  </a>
</article>
