---
import Layout from '../layouts/Layout.astro';
import CategoryView from '../components/CategoryView.astro';
import {
  getAlternatePathsForCategory,
  getBreadcrumbs,
  getCategories,
  getCategoryBySlug,
  getRelatedCategories,
  getStrings,
} from '../lib/content';
import { normalizeSlug } from '../lib/i18n';
import { createBreadcrumbJsonLd, createCategoryServiceJsonLd } from '../lib/seo';

export async function getStaticPaths() {
  const categories = await getCategories('en-US');

  return categories.map((category) => ({
    params: {
      slug: category.data.localizedSlug,
    },
  }));
}

const localePath = 'en-US';
const slug = normalizeSlug(Astro.params.slug);
const strings = await getStrings(localePath);
const category = await getCategoryBySlug(localePath, slug);
const alternatePaths = category ? await getAlternatePathsForCategory(category) : { [localePath]: slug };
const breadcrumbs = category ? getBreadcrumbs(category.data.categoryId, localePath) : [];
const relatedCategories = category ? getRelatedCategories(category.data.categoryId, localePath) : [];
const structuredData = category
  ? [
      createCategoryServiceJsonLd(Astro.site ?? Astro.url.origin, category, localePath),
      createBreadcrumbJsonLd(Astro.site ?? Astro.url.origin, localePath, breadcrumbs),
    ]
  : undefined;

if (!category) {
  Astro.response.status = 404;
}
---

{
  category ? (
    <Layout
      localePath={localePath}
      title={category.data.seo.title}
      description={category.data.seo.description}
      alternatePaths={alternatePaths}
      ogImage={category.data.ogImage}
      structuredData={structuredData}
      navigation={strings.navigation}
    >
      <CategoryView
        category={category}
        localePath={localePath}
        breadcrumbs={breadcrumbs}
        relatedCategories={relatedCategories}
        strings={strings}
      />
    </Layout>
  ) : (
    <Layout
      localePath={localePath}
      title="Category not found | Byron Equipment"
      description="The requested equipment category could not be found."
      alternatePaths={alternatePaths}
      navigation={strings.navigation}
    >
      <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <h1 class="text-3xl font-bold text-ink">Category not found</h1>
      </section>
    </Layout>
  )
}
